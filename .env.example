# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -hex 32

# --- PostgreSQL owner (migrations only) ---
POSTGRES_DB=solarmind
POSTGRES_USER=solarmind
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# --- Application role (RLS enforced), created by the first migration ---
SOLARMIND_APP_DB_PASSWORD=

# --- MQTT broker accounts ---
MQTT_PORT=1883
MQTT_WORKER_PASSWORD=
MQTT_GATEWAY_PASSWORD=

# --- Application ---
# development | test | staging | production (production disables OpenAPI docs)
SOLARMIND_ENVIRONMENT=development
SOLARMIND_LOG_LEVEL=INFO
# Encrypts MFA secrets at rest.
SOLARMIND_SECRET_KEY=
# true behind HTTPS (staging/production); false only for local http.
SOLARMIND_COOKIE_SECURE=false
SOLARMIND_WEB_BASE_URL=http://localhost:3000

# --- HTTP edge / limits (see docs/audit/2026-11-audit-performance-securite.md) ---
# Reverse proxies allowed to set X-Forwarded-For, as a JSON list of CIDR ranges.
# Required behind a proxy, otherwise all users share the proxy's rate limits.
# SOLARMIND_TRUSTED_PROXIES=["172.16.0.0/12"]
# SOLARMIND_MAX_REQUEST_BODY_BYTES=1048576
# SOLARMIND_MAX_INGEST_BODY_BYTES=8388608
# SOLARMIND_DB_POOL_SIZE=10
# SOLARMIND_DB_STATEMENT_TIMEOUT_MS=15000
# SOLARMIND_RATE_LIMIT_AI_PER_MINUTE=10
# SOLARMIND_LOGIN_MAX_FAILURES=10
# SOLARMIND_MFA_MAX_FAILURES=5
# SOLARMIND_ACCOUNT_LOCK_WINDOW_S=900
# Read cache in seconds (0 disables).
# SOLARMIND_CACHE_TTL_OVERVIEW_S=30
# SOLARMIND_CACHE_TTL_INSIGHTS_S=300
