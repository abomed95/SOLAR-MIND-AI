# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -hex 32

# --- PostgreSQL owner (migrations only) ---
POSTGRES_DB=solarmind
POSTGRES_USER=solarmind
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# --- Application role (RLS enforced), created by the first migration ---
SOLARMIND_APP_DB_PASSWORD=

# --- MQTT broker accounts ---
MQTT_PORT=1883
MQTT_WORKER_PASSWORD=
MQTT_GATEWAY_PASSWORD=

# --- Application ---
# development | test | staging | production (production disables OpenAPI docs)
SOLARMIND_ENVIRONMENT=development
SOLARMIND_LOG_LEVEL=INFO
# Encrypts MFA secrets at rest.
SOLARMIND_SECRET_KEY=
# true behind HTTPS (staging/production); false only for local http.
SOLARMIND_COOKIE_SECURE=false
SOLARMIND_WEB_BASE_URL=http://localhost:3000
