# Copy to .env and fill in. Never commit .env.
# Generate a password with: openssl rand -base64 32

POSTGRES_DB=solarmind
POSTGRES_USER=solarmind
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_PORT=8000

# development | test | staging | production (production disables OpenAPI docs)
SOLARMIND_ENVIRONMENT=development
SOLARMIND_LOG_LEVEL=INFO

# Only needed when running the API outside Docker Compose:
# SOLARMIND_DATABASE_URL=postgresql+asyncpg://solarmind:<password>@127.0.0.1:5432/solarmind
# SOLARMIND_REDIS_URL=redis://127.0.0.1:6379/0
